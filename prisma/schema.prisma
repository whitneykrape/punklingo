// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use 'sqlite' for simple local dev, switch to 'postgresql' for production later
  provider = "sqlite" 
  url      = env("DATABASE_URL")
}

model Question {
  id          String   @id @default(cuid())
  title       String
  content     Text?
  askerName   String
  viewsCount  Int      @default(0)
  answers     Answer[]
  createdAt   DateTime @default(now())

  @@index([title])
}

model Answer {
  id        String    @id @default(cuid())
  content   Text
  author    String?
  accepted  Boolean   @default(false)
  questionId String
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([questionId])
}

// Optional: Simple seed script placeholder
generator client {
  provider = "prisma-client-js"
  // Tells Prisma to run seed.ts whenever a migration is deployed
  // Note: This feature depends on the schema definition, sometimes you need to run manually for dev
}

// OR in package.json scripts:
// "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"